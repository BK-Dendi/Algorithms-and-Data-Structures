void solve() {
    int r, s;
    cin >> r >> s;
    int m, n, p, q;
    cin >> m >> n >> p >> q;
    
    int ax = 0, ay = 0;
    int bx = r, by = s;
    int t = 0;
    
    while(ax < bx && ay < by) {
        ax += m; ay += n;
        bx -= p; by -= q;
        t++;
    }
    
    if (ax == bx && ay == by) {
        cout << t << "\n";
    }else {
        cout << -1 << "\n";
    }
}
