void solve() {
    int n;
    cin >> n;
    int A[n];
    int C[n];
    
    for(int i = 0; i < n; i++) {
        cin >> C[i];
    }
    for(int i = 0; i < n; i++) {
        cin >> A[i];
    }
    
    for(int i = 0; i < n - 1; i++) {
        int amt = min(A[i], C[i + 1] - A[i + 1]);
        A[i] -= amt;
        A[i + 1] += amt;
    }
    
    for(int i = 0; i < n; i++) {
        cout << A[i] << "\n";
    }
}
