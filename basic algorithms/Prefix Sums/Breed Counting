int pref[100010][4];
void solve() {
    int n, q;
    cin >> n >> q;
    vector<ll> res(n);
    for(int i = 1; i <= n; i++) {
        int breed;
        cin >> breed;
        pref[i][1] = pref[i - 1][1];
        pref[i][2] = pref[i - 1][2];
        pref[i][3] = pref[i - 1][3];
        
        pref[i][breed]++;
    }
    
    for(int i = 0; i < q; ++i) {
        int a,b;
        cin >> a >> b;
        
        cout << pref[b][1] - pref[a - 1][1] << " " <<
                pref[b][2] - pref[a - 1][2] << " " <<
                pref[b][3] - pref[a - 1][3] << "\n";
    }
    
 }
