vector<ll> psum(const vector<ll> &arr) {
    vector<ll> prefix_arr(arr.size() + 1, 0);
    for(int i = 1; i < arr.size(); i++) {
        prefix_arr[i] = prefix_arr[i - 1] + arr[i];
    }
    return prefix_arr;
}

void solve() {
    int n, q;
    cin >> n >> q;
    vector<ll> res(n);
    for(int i = 0; i < n; i++) {
        cin >> res[i];
    }
    vector<ll> prefix = psum(res);
    for(int i = 0; i < q; ++i) {
        int l,r;
        cin >> l >> r;
        cout << prefix[r - 1] - prefix[l - 1] << "\n";
    }
 }
