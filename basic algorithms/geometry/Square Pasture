vector<ll> psum(const vector<ll> &arr) {
    vector<ll> prefix_arr(arr.size() + 1, 0);
    for(int i = 1; i < arr.size(); i++) {
        prefix_arr[i] = prefix_arr[i - 1] + arr[i];
    }
    return prefix_arr;
}


