void solve() {
    int n;
    string s;
    cin >> n >> s;
    
    for(int k = 1; k <= n; k++) {
        set<string> subs;
        bool has_sub = false;
        for(int i = 0; i <= n - k; i++) {
            string sub = s.substr(i,k);
            
            if (subs.count(sub)) {
                has_sub = true;
                break;
            }
            subs.insert(sub);
        }
        
        if (!has_sub) {
            cout << k << "\n";
            break;
        }
    }
}
