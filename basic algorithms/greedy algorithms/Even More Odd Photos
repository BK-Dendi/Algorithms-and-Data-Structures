void solve() {
    int n;
    cin >> n;
    int even = 0;
    int odd = 0;
    
    for(int i = 0; i < n; i++) {
        int x;
        cin >> x;
        
        if (x % 2 == 0) {
            even++;
        }else {
            odd++;
        }
    }
    
    while(odd > even) {
        odd -= 2;
        even+= 1;
    }
    
    if (even > odd + 1) {
        even = odd + 1;
    }
    
    cout << even + odd << "\n";
}
