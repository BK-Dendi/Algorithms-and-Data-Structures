void solve() {
    ll n;
    string a,b;
    cin >> n >> a >> b;
    bool mis = false;
    ll ans = 0;
    for(ll i = 0; i < n; i++) {
        if (a[i] != b[i]) {
            if (!mis) {
                mis = true;
                ans++;
            }
        }else {
            mis = false;
        }
    }
    
    cout << ans << "\n";
}
