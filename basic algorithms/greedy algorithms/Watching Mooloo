void solve() {
    ll n, k;
    cin >> n >> k;
    vector<ll> res(n);
    for(ll i = 0; i < n; i++) {
        cin >> res[i];
    }
    
    ll ans = k + 1;
    
    for(ll i = 1; i < n; i++) {
        ll diff = res[i] - res[i - 1];
        
        ll all = k + 1;
        
        ans += min(diff, all);
    }
    cout << ans << "\n";
}

