void solve() {
    int n;
    cin >> n;
    vector<int> res(n);
    for(int i = 0; i < n; i++) {
        cin >> res[i];
    }
    
    vector<int> t = res;
    sort(res.begin(), res.end());
    int diff = 0;
    for(int i = 0; i < n; i++) {
        if (t[i] != res[i]) {
            diff++;
        }
    }
    
    cout << max(0, diff - 1) << "\n";
}
